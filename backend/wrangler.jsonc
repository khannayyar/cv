{
  "name": "nayyar-profile-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://khannayyar.github.io",
    "PUBLIC_SITE_URL": "https://khannayyar.github.io/cv/",
    "DEEPSEEK_MODEL": "deepseek-flash"
  },
  "ratelimits": [
    {"name": "ASK_RATE_LIMITER", "namespace_id": "14001", "simple": {"limit": 5, "period": 60}},
    {"name": "GLOBAL_RATE_LIMITER", "namespace_id": "14002", "simple": {"limit": 30, "period": 60}}
  ],
  "observability": {"enabled": false}
}
